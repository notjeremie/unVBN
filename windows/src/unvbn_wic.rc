#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION UNVBN_VERSION_COMMA
PRODUCTVERSION UNVBN_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "unVBN"
            VALUE "FileDescription", "unVBN WIC codec for Vizrt .vbn images"
            VALUE "FileVersion", UNVBN_VERSION_STR
            VALUE "InternalName", "unvbn_wic"
            VALUE "LegalCopyright", "Copyright (c) 2026 Jeremie Quenet. MIT License."
            VALUE "OriginalFilename", "unvbn_wic.dll"
            VALUE "ProductName", "unVBN"
            VALUE "ProductVersion", UNVBN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
