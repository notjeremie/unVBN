// Export window: dialog template, icon, version. Built with version.h from ../version.h.in.
#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "unvbn.ico"
1 RT_MANIFEST "app.manifest"

// 330 x 262 dialog units; the drop zone is the etched frame at the top, the whole window accepts drops.
IDD_MAIN DIALOGEX 0, 0, 330, 262
STYLE DS_SHELLFONT | DS_CENTER | WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_ACCEPTFILES | WS_EX_APPWINDOW
CAPTION "unVBN Export"
CLASS "unVBN.ExportWindow"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_DROPFRAME, "Static", SS_ETCHEDFRAME, 10, 8, 310, 52
    CTEXT           "Drop .vbn sequence folders or a frame here", IDC_DROPHINT, 14, 14, 302, 10
    CTEXT           "Several folders export one after the other, with the same settings", IDC_DROPSUB, 14, 26, 302, 10
    PUSHBUTTON      "Choose folders…", IDC_CHOOSE, 125, 40, 80, 14
    CONTROL         "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 66, 310, 82
    LTEXT           "", IDC_FRAMES, 10, 152, 310, 10
    LTEXT           "Format:", IDC_FORMAT_LABEL, 10, 170, 56, 10
    COMBOBOX        IDC_FORMAT, 70, 168, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Frame rate:", IDC_FPS_LABEL, 10, 188, 56, 10
    COMBOBOX        IDC_FPS, 70, 186, 70, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Background:", IDC_BG_LABEL, 10, 206, 56, 10
    CONTROL         "", IDC_BG_SWATCH, "Button", BS_OWNERDRAW | WS_TABSTOP, 70, 204, 22, 14
    PUSHBUTTON      "Choose…", IDC_BG_CHOOSE, 96, 204, 50, 14
    LTEXT           "", IDC_ERROR, 10, 222, 310, 16
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", NOT WS_VISIBLE, 10, 226, 310, 8
    LTEXT           "", IDC_STATUS, 10, 242, 176, 10, SS_ENDELLIPSIS
    RTEXT           "", IDC_PERCENT, 186, 242, 30, 10
    PUSHBUTTON      "Show in Explorer", IDC_REVEAL, 186, 240, 70, 14, NOT WS_VISIBLE
    DEFPUSHBUTTON   "Export…", IDOK, 260, 240, 60, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION UNVBN_VERSION_COMMA
 PRODUCTVERSION UNVBN_VERSION_COMMA
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "unVBN"
            VALUE "FileDescription", "unVBN Export: Vizrt .vbn sequences to PNG, MP4, WebM"
            VALUE "FileVersion", UNVBN_VERSION_STR
            VALUE "InternalName", "unvbn-export"
            VALUE "LegalCopyright", "Copyright (c) 2026 Jeremie Quenet. MIT License."
            VALUE "OriginalFilename", "unvbn-export.exe"
            VALUE "ProductName", "unVBN"
            VALUE "ProductVersion", UNVBN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
