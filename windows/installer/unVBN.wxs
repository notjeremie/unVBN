<!--
  unVBN for Windows: installs the WIC codec so Windows can open Vizrt .vbn images, and the export tools:
  unvbn.exe (command line, added to PATH) and unvbn-export.exe (export window, opened from Explorer's
  "Export with unVBN..." on folders).
  Built in CI:  wix build unVBN.wxs -arch x64|arm64 -d Version=0.3.2 -d BinDir=build\Release -d RepoRoot=...
  Registration: the DLL's own DllRegisterServer/DllUnregisterServer (SelfReg), the single source of truth
  for its registry entries, also used by `regsvr32`.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="unVBN (Vizrt .vbn images for Windows)"
           Manufacturer="unVBN"
           Version="$(var.Version)"
           UpgradeCode="BB4DA954-4F46-4AAD-B1E7-BF0B4AB1B3E1"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Lets Windows open Vizrt Viz Artist / Viz Engine .vbn images" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of unVBN is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/notjeremie/unVBN" />
    <Property Id="ARPHELPLINK" Value="https://github.com/notjeremie/unVBN" />
    <Property Id="ARPCOMMENTS" Value="Explorer thumbnails and preview for .vbn images; export of .vbn sequences to PNG, MP4 and WebM" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="unVBN">
        <Component Id="Codec">
          <File Id="CodecDll" Source="$(var.BinDir)\unvbn_wic.dll" Name="unvbn_wic.dll" KeyPath="yes" SelfRegCost="1" />
        </Component>
        <Component Id="Cli">
          <File Id="CliExe" Source="$(var.BinDir)\unvbn.exe" Name="unvbn.exe" KeyPath="yes" />
          <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
        </Component>
        <Component Id="ExportApp">
          <File Id="ExportExe" Source="$(var.BinDir)\unvbn-export.exe" Name="unvbn-export.exe" KeyPath="yes" />
          <!-- Right-click a folder: "Export with unVBN...". Several selected folders join one window. -->
          <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\Directory\shell\unVBN.Export">
            <RegistryValue Name="MUIVerb" Type="string" Value="Export with unVBN…" />
            <RegistryValue Name="Icon" Type="string" Value="&quot;[#ExportExe]&quot;,0" />
            <RegistryKey Key="command">
              <RegistryValue Type="string" Value="&quot;[#ExportExe]&quot; &quot;%1&quot;" />
            </RegistryKey>
          </RegistryKey>
        </Component>
        <Component Id="License">
          <File Id="LicenseFile" Source="$(var.RepoRoot)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <!-- libvpx and libwebm (BSD) licences, collected from vcpkg at build time (CMake: notices target). -->
        <Component Id="Notices">
          <File Id="NoticesFile" Source="$(var.BinDir)\THIRD_PARTY_NOTICES.txt" Name="THIRD_PARTY_NOTICES.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Wizard: welcome + license, progress, then a "Completed" page (WixUI_Minimal). -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoRoot)\windows\installer\License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Windows can now open .vbn images. To export a sequence, right-click its folder and choose Export with unVBN, or run unvbn in a terminal. If Explorer shows no thumbnails yet, sign out and back in." />

    <Feature Id="Main" Title="unVBN">
      <ComponentRef Id="Codec" />
      <ComponentRef Id="Cli" />
      <ComponentRef Id="ExportApp" />
      <ComponentRef Id="License" />
      <ComponentRef Id="Notices" />
    </Feature>
  </Package>
</Wix>
